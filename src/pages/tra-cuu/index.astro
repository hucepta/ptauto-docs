---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SearchForm from '../../components/SearchForm.astro';
import { getContent } from '../../content/catalog';
import { getContentUrl } from '../../domain/content/graph';
import { withBase } from '../../domain/content/urls';
const { graph } = await getContent();
---
<SiteLayout title="Tra cứu API" description="Tra cứu cú pháp, hàm và API theo công nghệ."><div class="page">
<h1>Tra cứu API</h1><p>Tìm hàm, cú pháp và cách dùng khi đang viết code. Nếu cần hiểu tên gọi cơ bản, hãy mở <a href={withBase('/thuat-ngu/')}>Từ điển kỹ thuật</a>.</p><SearchForm />
{graph.courses.map(c=><section class="related"><h2><a href={withBase('/tra-cuu/'+c.technology+'/')}>{c.title}</a></h2>
<ul class="link-list">{graph.concepts.filter(con=>con.technology===c.technology&&con.kind!=='term').map(con=><li><a href={withBase(getContentUrl(graph,con.id))}>{con.title}</a><p>{con.description}</p></li>)}</ul></section>)}
</div></SiteLayout>

