---
import { render } from 'astro:content';
import LearnLayout from '../../../layouts/LearnLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ConceptLinks from '../../../components/ConceptLinks.astro';
import ArticleSteps from '../../../components/ArticleSteps.astro';
import ArticleEnd from '../../../components/ArticleEnd.astro';
import Exercise from '../../../components/Exercise.astro';
import { getContent } from '../../../content/catalog';
import { getLessonCourse, getContentUrl, getLessonNavigation } from '../../../domain/content/graph';
import type { ChapterEntry, ExerciseEntry } from '../../../domain/content/schema';
import { withBase } from '../../../domain/content/urls';
export async function getStaticPaths() { const { graph } = await getContent(); return graph.lessons.map(lesson => ({ params: { course: getLessonCourse(graph, lesson).slug, lesson: lesson.slug }, props: { lesson } })); }
const { lesson } = Astro.props;
const { graph, lessons } = await getContent();
const course = getLessonCourse(graph, lesson);
const chapter = graph.entries.get(lesson.chapterId) as ChapterEntry;
const entry = lessons.find(l => l.data.id === lesson.id)!;
const { headings } = await render(entry);
const nav = getLessonNavigation(graph, lesson.id);
---
<LearnLayout title={lesson.title} description={lesson.description} graph={graph} courseId={course.id} activeId={lesson.id} headings={headings}>
<Breadcrumbs items={[{title:'Trang chủ',url:'/'},{title:course.title,url:getContentUrl(graph,course.id)},{title:chapter.title,url:getContentUrl(graph,chapter.id)}]} />
<header data-content-id={lesson.id} data-content-kind="lesson"><h1>{lesson.title}</h1>
<div class="article-meta"><span>{lesson.difficulty==='co-ban'?'Cơ bản':lesson.difficulty==='trung-cap'?'Trung cấp':'Nâng cao'}</span><span>Bài học</span></div>
<div class="article-actions"><button class="js-control" data-bookmark={lesson.id} aria-pressed="false">Lưu bài</button><button class="js-control" data-completed={lesson.id} aria-pressed="false">Đánh dấu hoàn thành</button></div><p class="status-message" data-storage-status role="status"></p></header>
{nav.prerequisites.length>0&&<section class="related" data-pagefind-ignore><h2>Kiến thức cần có</h2><ul class="link-list">{nav.prerequisites.map(id=><li><a href={withBase(getContentUrl(graph,id))}>{graph.entries.get(id)!.title}</a></li>)}</ul></section>}
<ArticleSteps html={entry.rendered!.html} graph={graph} exampleIds={lesson.exampleIds} placements={lesson.examplePlacements} />
{lesson.exerciseIds.map(id=><Exercise exercise={graph.entries.get(id) as ExerciseEntry} visibleExampleIds={lesson.exampleIds} />)}
<ConceptLinks graph={graph} ids={lesson.conceptIds} /><ArticleEnd sources={lesson.sources} compatibility={lesson.compatibility} />
<nav class="lesson-pager" aria-label="Chuyển bài" data-pagefind-ignore>
{nav.previous?<a href={withBase(getContentUrl(graph,nav.previous))}><span>Bài trước</span>{graph.entries.get(nav.previous)!.title}</a>:<span></span>}
{nav.next?<a href={withBase(getContentUrl(graph,nav.next))}><span>Bài tiếp</span>{graph.entries.get(nav.next)!.title}</a>:<span class="muted">Bạn đã tới bài cuối hiện có.</span>}
</nav></LearnLayout>

