---
import '../../styles/tokens.css';
import { withBase } from '../../domain/content/urls';
import { getBuildData } from '../../content/build-data';
const { buildId } = await getBuildData();
const destination = withBase('/#chu-de');
---
<!doctype html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Chủ đề học · PTAuto Docs</title><meta name="ptauto-build" content={buildId}/><meta http-equiv="refresh" content={`0;url=${destination}`}/><link rel="canonical" href={new URL(withBase('/'),Astro.site)}/></head>
<body><main id="content"><h1>Chủ đề học</h1><a href={destination}>Mở các chủ đề trên trang chủ</a></main></body></html>
<style>main { max-width: 760px; margin: 4rem auto; padding: 0 1.5rem; }</style>

