---
import { getCourseLessons, getContentUrl, type ContentGraph } from '../domain/content/graph';
import type { CourseEntry } from '../domain/content/schema';
import { withBase } from '../domain/content/urls';
interface Props {
    graph: ContentGraph;
}
const { graph } = Astro.props;
const courses = [...graph.entries.values()].filter((c): c is CourseEntry => c.entity === 'course').sort((a, b) => a.order - b.order);
const marks = { autolisp: 'LSP', 'visual-lisp-activex': 'VL', 'autocad-dotnet': 'C#', 'civil3d-dotnet': 'C3D', 'dynamo-python': 'PY', 'gis-data-automation': 'GIS' };
---
<div class="catalog">{courses.map(course=>{
const lessons=getCourseLessons(graph,course.id);
return <div class="catalog-row"><span class="subject-mark" aria-hidden="true">{marks[course.technology]}</span><div>
<h3>{course.status==='published'?<a href={withBase(getContentUrl(graph,course.id))}>{course.title} <span aria-hidden="true">→</span></a>:<span>{course.title}</span>}</h3>
<p>{course.description}</p></div><span class:list={['catalog-state',{active:course.status==='published'}]}>{course.status==='published'?lessons.length+' bài học':'Đang biên soạn'}</span></div>;
})}</div>

