---
import type { ProjectFramework } from '../content/project-framework';
interface Props { visual: ProjectFramework['visual']; output: string; heading?: string; note?: string; outputLabel?: string; }
const { visual, output, heading = 'Hình minh họa kết quả', note = 'Mô phỏng để đối chiếu, không phải ảnh chụp AutoCAD', outputLabel = 'Kết quả cần đối chiếu' } = Astro.props;
---
<figure class="project-illustration">
  <figcaption><strong>{heading}</strong><span>{note}</span></figcaption>
  <svg viewBox="0 0 760 310" role="img" aria-label={output}>
    <rect width="760" height="310" rx="8" fill="#0b263d" />
    {visual === 'report' && <g><rect x="140" y="42" width="480" height="228" rx="5" fill="#f1f8fa"/><path d="M140 92H620M140 150H620M140 208H620M360 42V270" stroke="#b6d2dd" stroke-width="2"/><rect x="367" y="157" width="246" height="44" fill="#b6ebd7"/><g fill="#153b53" font-size="18"><text x="164" y="76">Đối tượng</text><text x="387" y="76">Kết quả</text><text x="164" y="129">ID 01</text><text x="387" y="129">Đạt</text><text x="164" y="187">ID 02</text><text x="387" y="187">Cần kiểm tra</text><text x="164" y="245">Tổng hợp</text><text x="387" y="245">Báo cáo QA</text></g></g>}
    {visual === 'layers' && <g fill="none" stroke-width="10" stroke-linecap="round"><path d="M80 90C220 185 400 55 680 105" stroke="#6ac8de"/><path d="M80 160C220 255 400 125 680 175" stroke="#ffd27a"/><path d="M80 230C220 305 400 195 680 245" stroke="#80bce4"/><g fill="#e9f6fb" stroke="none" font-size="17"><text x="80" y="59">Layer tuyến</text><text x="80" y="145">Layer cần đối chiếu</text><text x="80" y="217">Layer khác</text></g></g>}
    {visual === 'station' && <g><path d="M45 224C190 252 255 135 380 153S560 105 705 48" stroke="#4e8cae" stroke-width="18" fill="none"/><path d="M45 224C190 252 255 135 380 153S560 105 705 48" stroke="#91e5d7" stroke-width="4" fill="none"/><g fill="#ffd27a" stroke="#0b263d" stroke-width="3"><circle cx="47" cy="224" r="10"/><circle cx="190" cy="211" r="10"/><circle cx="356" cy="152" r="10"/><circle cx="532" cy="126" r="10"/><circle cx="704" cy="49" r="10"/></g><g fill="#f0f8fa" font-size="16"><text x="40" y="263">0+000</text><text x="172" y="246">0+020</text><text x="339" y="186">0+040</text><text x="515" y="161">0+060</text></g></g>}
    {visual === 'curve' && <g><path d="M72 220C120 55 300 290 408 112S602 40 690 198" stroke="#89cde4" stroke-width="9" fill="none"/><path d="M224 131L322 132" stroke="#ffd27a" stroke-width="3" stroke-dasharray="8 6"/><circle cx="322" cy="132" r="10" fill="#ffd27a"/><g fill="#edf8fc" font-size="18"><text x="80" y="62">Curve nguồn</text><text x="334" y="120">Điểm kiểm tra</text><text x="525" y="260">Đoạn tuyến</text></g></g>}
    {visual === 'metadata' && <g><rect x="90" y="62" width="218" height="174" rx="7" fill="#164765" stroke="#76d8d8" stroke-width="3"/><rect x="452" y="62" width="218" height="174" rx="7" fill="#164765" stroke="#76d8d8" stroke-width="3"/><path d="M308 148H452" stroke="#ffd27a" stroke-width="4"/><path d="m440 137 13 11-13 11" fill="none" stroke="#ffd27a" stroke-width="4"/><g fill="#eef9fc" font-size="19"><text x="130" y="117">Đối tượng CAD</text><text x="130" y="157">ObjectId · Layer</text><text x="493" y="117">Dữ liệu gắn</text><text x="493" y="157">Mã · Trạng thái</text></g></g>}
    {visual === 'profile' && <g><path d="M75 250H698M75 38V250" stroke="#83aabe" stroke-width="3"/><path d="M82 217 220 196 365 100 510 143 670 60" stroke="#82d7d5" stroke-width="7" fill="none"/><g fill="#ffd27a"><circle cx="220" cy="196" r="10"/><circle cx="365" cy="100" r="10"/><circle cx="510" cy="143" r="10"/></g><g fill="#f2f8fa" font-size="17"><text x="358" y="82">PVI</text><text x="590" y="285">Station</text><text x="23" y="44">Z</text></g></g>}
    {visual === 'network' && <g><path d="M92 157H262L365 84H536M536 84 661 181" stroke="#67bbd8" stroke-width="13" fill="none" stroke-linecap="round"/><g fill="#ffd27a" stroke="#0b263d" stroke-width="4"><circle cx="92" cy="157" r="16"/><circle cx="262" cy="157" r="16"/><circle cx="365" cy="84" r="16"/><circle cx="661" cy="181" r="16"/></g><circle cx="536" cy="84" r="27" fill="none" stroke="#ffae7e" stroke-width="5"/><g fill="#f2f8fa" font-size="17"><text x="77" y="207">Nút</text><text x="455" y="51">Điểm cần kiểm</text><text x="624" y="229">Đầu ống</text></g></g>}
    {visual === 'graph' && <g><g fill="#164765" stroke="#77d7d2" stroke-width="3"><rect x="60" y="92" width="170" height="115" rx="8"/><rect x="295" y="92" width="170" height="115" rx="8"/><rect x="530" y="92" width="170" height="115" rx="8"/></g><path d="M230 150H295M465 150H530" stroke="#ffd27a" stroke-width="5"/><g fill="#eef8fb" font-size="20" text-anchor="middle"><text x="145" y="155">Input</text><text x="380" y="155">Xử lý</text><text x="615" y="155">Watch</text></g></g>}
    {visual === 'map' && <g><path d="M50 230 220 95 345 175 500 50 710 180" fill="none" stroke="#79b9d3" stroke-width="23" stroke-linecap="round"/><path d="M50 230 220 95 345 175 500 50 710 180" fill="none" stroke="#a6eee0" stroke-width="4"/><g fill="#ffd27a" stroke="#153c55" stroke-width="3"><circle cx="220" cy="95" r="12"/><circle cx="345" cy="175" r="12"/><circle cx="500" cy="50" r="12"/></g><g fill="#eef8fb" font-size="17"><text x="72" y="277">Feature nguồn</text><text x="520" y="263">Lớp GIS đích</text></g></g>}
    {visual === 'terminal' && <g><rect x="65" y="43" width="630" height="222" rx="9" fill="#122f47" stroke="#79bbd2" stroke-width="3"/><path d="M65 87H695" stroke="#79bbd2" stroke-width="2"/><g fill="#ffd27a"><circle cx="93" cy="66" r="7"/><circle cx="117" cy="66" r="7"/><circle cx="141" cy="66" r="7"/></g><g fill="#d4f4ec" font-family="monospace" font-size="19"><text x="92" y="132">Command: APPLOAD</text><text x="92" y="173">Command: HELLO</text><text x="92" y="214">&gt; Kết quả trong AutoCAD</text></g></g>}
    {visual === 'dialog' && <g><rect x="160" y="35" width="440" height="238" rx="9" fill="#edf8fb" stroke="#79bbd2" stroke-width="3"/><rect x="160" y="35" width="440" height="49" rx="9" fill="#2c6888"/><g fill="#fff" font-size="20"><text x="182" y="67">Hộp thoại DCL</text></g><rect x="190" y="116" width="380" height="43" fill="#fff" stroke="#9ebfcf"/><g fill="#24465b" font-size="17"><text x="201" y="105">Giá trị nhập</text><text x="205" y="144">layer_chuan</text></g><rect x="356" y="196" width="92" height="43" rx="5" fill="#c8eee0"/><rect x="464" y="196" width="104" height="43" rx="5" fill="#e4edf0"/><g fill="#17435b" font-size="17"><text x="386" y="224">OK</text><text x="481" y="224">Cancel</text></g></g>}
  </svg><p><strong>{outputLabel}:</strong> {output}</p>
</figure>
