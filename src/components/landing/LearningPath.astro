---
interface Props { steps: { title: string; cue: string; href: string }[]; }
const { steps } = Astro.props;
---
<div class="learning-path motion-reveal">
  <ol>{steps.map((step,index)=><li><span class="path-node" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><code>{step.cue}</code><h3><a href={step.href}>{step.title}</a></h3></li>)}</ol>
</div>
