---
import { resolve } from 'node:path';
import { getContent } from '../../content/catalog';
import { readExampleCode } from '../../domain/content/example-source';
const { graph } = await getContent();
const example = graph.examples.find(example => example.id === 'example.autolisp.demo-stakes');
if (!example) throw new Error('Missing canonical stake example.');
const source = await readExampleCode(example, resolve('src/content/examples/code'));
const actions = [
  { key: 'select', label: '01 Chọn tuyến', description: 'Chọn đúng một tim tuyến LWPOLYLINE.' },
  { key: 'measure', label: '02 Đo tuyến', description: 'Nhập bước 20 m và đo chiều dài tuyến.' },
  { key: 'sample', label: '03 Lấy lý trình', description: 'Tìm điểm trên tuyến tại 0, 20, 40, 60 và 80 m.' },
  { key: 'mark', label: '04 Đặt mốc', description: 'Tạo marker trên bản vẽ và đếm kết quả.' },
];
const steps = actions.map(action => {
  const code = source.split(';; step:' + action.key + '\n')[1]?.split(';; step:')[0]?.trim();
  if (!code) throw new Error('Missing example step: ' + action.key);
  return { ...action, code };
});
const stakes = [
  { x: 93, y: 275, label: '0+000' },
  { x: 164, y: 260, label: '0+020' },
  { x: 235, y: 223, label: '0+040' },
  { x: 306, y: 187, label: '0+060' },
  { x: 378, y: 162, label: '0+080' },
];
---
<div class="code-geometry-demo motion-reveal" data-code-demo data-step="3">
  <div class="geometry-code">
    <div class="demo-toolbar"><span>{example.sourceFile}</span><span>AutoLISP</span></div>
    <div class="code-sequence">{steps.map((step, index) => <div class="code-step" data-code-step={index} aria-current={index === 3 ? 'step' : undefined}><span class="code-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><p>{step.description}</p><pre><code>{step.code}</code></pre></div></div>)}</div>
  </div>
  <div class="geometry-output">
    <div class="demo-toolbar"><span>Tim tuyến · bản vẽ thử</span><span class="simulation-label">Minh họa kết quả từng bước</span></div>
    <svg id="demo-geometry" viewBox="0 0 520 370" fill="none" role="img" aria-label="Tim tuyến cong dài 95 mét và năm mốc cách nhau 20 mét">
      <defs><pattern id="demo-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" stroke="#075d9b" stroke-opacity=".09"/></pattern></defs>
      <rect width="520" height="370" fill="url(#demo-grid)"/>
      <path d="M93 275 C145 285 169 260 211 237 S293 191 345 172 S417 147 455 109" stroke="#b6d1db" stroke-width="17" stroke-linecap="round"/>
      <path class="route-line" d="M93 275 C145 285 169 260 211 237 S293 191 345 172 S417 147 455 109" stroke="#075d9b" stroke-width="3" stroke-linecap="round"/>
      <g class="route-measure"><path d="M93 310H455" stroke="#77a7b9" stroke-dasharray="5 5"/><path d="M93 301v18M455 301v18" stroke="#77a7b9"/><text x="274" y="330" text-anchor="middle">Tim tuyến 95 m · bước 20 m</text></g>
      <g class="stake-guides" stroke="#77a7b9" stroke-dasharray="4 4">{stakes.map(stake => <path d={`M${stake.x} ${stake.y + 8}V306`} />)}</g>
      <g class="stake-points">{stakes.map((stake, index) => <g class="stake-point" style={`--stake-delay:${index * 100}ms`}><circle cx={stake.x} cy={stake.y} r="7" fill="#ffd27a" stroke="#075d9b" stroke-width="2"/><text x={stake.x} y={stake.y - 16} text-anchor="middle">{stake.label}</text></g>)}</g>
      <text x="30" y="347" class="drawing-note">Đơn vị bản vẽ: m · 5 mốc được tạo</text>
    </svg>
    <div class="demo-controls js-control">{steps.map((step, index) => <button type="button" data-demo-button={index} aria-controls="demo-geometry" aria-pressed={index === 3 ? 'true' : 'false'}>{step.label}</button>)}</div>
  </div>
</div>
