---
// Các biểu thức được rút từ c:RC của Road_Contours_Tool_VI.lsp do tác giả cung cấp.
// Hình vẽ là sơ đồ giải thích, không phải kết quả chạy AutoCAD.
const steps = [
  { label: '01 Chọn tuyến', description: 'Chọn điểm A, B và tim tuyến; dựng hệ tọa độ dọc tuyến.', code: `(setq route
  (RCT:route-build point-a point-b route-entity))
(setq point-a (RCT:route-value route 'point-a)
      point-b (RCT:route-value route 'point-b))` },
  { label: '02 Nhập thông số', description: 'Đặt cao độ, bề rộng, độ dốc và bước đường đồng mức trong hộp thoại.', code: `(setq ha (nth 0 dialog-values)
      hb (nth 1 dialog-values)
      road-width (nth 2 dialog-values)
      sidewalk-width (nth 3 dialog-values)
      contour-step (nth 7 dialog-values))` },
  { label: '03 Tính đường', description: 'Tính điểm giao theo cao độ, nối các đoạn thành đường đồng mức.', code: `(setq contour-polylines
  (RCT:contour-polylines contour-segments))
(setq world-contour-polyline
  (RCT:world-polyline base contour-polyline))` },
  { label: '04 Lên cao độ', description: 'Đưa đường đồng mức vào bản vẽ và ghi nhãn cao độ.', code: `(foreach contour-polyline contour-polylines
  (setq world-contour-polyline
    (RCT:world-polyline base contour-polyline))
  (RCT:lwpolyline world-contour-polyline layer
    (if contour-elevation-enabled level nil)))` },
];
---
<div class="code-geometry-demo motion-reveal" data-code-demo data-step="0">
  <div class="geometry-code">
    <div class="demo-toolbar"><span>Road_Contours_Tool_VI.lsp · c:RC</span></div>
    <div class="code-sequence">{steps.map((step, index) => <div class="code-step" data-code-step={index} hidden={index !== 0} aria-current={index === 0 ? 'step' : undefined}><span class="code-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><p>{step.description}</p><pre><code>{step.code}</code></pre></div></div>)}</div>
  </div>
  <div class="geometry-output">
    <div class="demo-toolbar"><span>Tim tuyến</span></div>
    <svg id="demo-geometry" viewBox="0 0 520 290" fill="none" role="img" aria-label="Sơ đồ tim tuyến và các đường đồng mức nền đường hiện dần theo bốn bước">
      <path d="M40 212 C158 225 202 184 292 156 S425 120 480 63" stroke="#8cbbd0" stroke-width="19" stroke-linecap="round"/>
      <path class="route-line" d="M40 212 C158 225 202 184 292 156 S425 120 480 63" stroke="#075d9b" stroke-width="3" stroke-linecap="round"/>
      <g class="contour-settings"><path d="M104 188v53M200 165v50M296 127v54M396 88v57" stroke="#9bb7c5" stroke-dasharray="5 4"/><text x="34" y="266">A · cao độ đầu</text><text x="370" y="35">B · cao độ cuối</text></g>
      <g class="contour-lines" stroke="#008c9e" stroke-width="2.5" stroke-linecap="round"><path d="M80 112 Q139 175 140 256"/><path d="M154 74 Q216 150 215 236"/><path d="M232 52 Q300 135 291 210"/><path d="M315 35 Q376 113 376 180"/></g>
      <g class="contour-labels"><text x="79" y="104">+10.0</text><text x="155" y="68">+10.5</text><text x="237" y="48">+11.0</text><text x="321" y="30">+11.5</text></g>
    </svg>
    <div class="demo-controls js-control">{steps.map((step, index) => <button type="button" data-demo-button={index} aria-controls="demo-geometry" aria-pressed={index === 0 ? 'true' : 'false'}>{step.label}</button>)}</div>
  </div>
</div>
