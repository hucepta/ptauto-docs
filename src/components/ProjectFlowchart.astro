---
import type { ProjectFramework } from '../content/project-framework';
interface Props { steps: [string, string, string]; framework: ProjectFramework; output: string; check: string; }
const { steps, framework, output, check } = Astro.props;
---
<figure class="project-flowchart">
  <figcaption>Sơ đồ luồng xử lý</figcaption>
  <div class="flow-node flow-start">Bắt đầu</div><div class="flow-connector" aria-hidden="true">↓</div>
  <div class="flow-node flow-process"><small>01 · Chuẩn bị</small>{steps[0]}</div><div class="flow-connector" aria-hidden="true">↓</div>
  <div class="flow-node flow-process"><small>02 · Xác lập dữ liệu</small>{steps[1]}</div><div class="flow-connector" aria-hidden="true">↓</div>
  <div class="flow-gate"><span>{framework.gate}</span></div>
  <div class="flow-branches">
    <div class="flow-branch"><b>Không ↓</b><div class="flow-node flow-reject">{framework.reject}</div><span class="flow-finish">Kết thúc nhánh lỗi</span></div>
    <div class="flow-branch"><b>Có ↓</b><div class="flow-node flow-process"><small>03 · Thực thi</small>{steps[2]}</div><div class="flow-connector" aria-hidden="true">↓</div><div class="flow-node flow-output">{output}</div><div class="flow-connector" aria-hidden="true">↓</div><div class="flow-node flow-process"><small>04 · Đối chiếu</small>{check}</div><span class="flow-finish">Kết thúc sau kiểm tra</span></div>
  </div>
</figure>
