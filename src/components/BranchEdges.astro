---
interface Props { merge?: boolean; both?: boolean; }
const { merge = false, both = false } = Astro.props;
const path = merge ? (both ? 'M25 0V10H50V35M75 0V10H50' : 'M75 0V10H50V35') : 'M50 0V10H25V28M50 10H75V28';
---
<div class="branch-connector" aria-hidden="true">
  <svg class="branch-edges" viewBox="0 0 100 35" preserveAspectRatio="none"><path d={path} fill="none" stroke="#255d7c" stroke-width="1.5" vector-effect="non-scaling-stroke" /></svg>
  {!merge&&<><span class="branch-tip" style="left:25%"></span><span class="branch-tip" style="left:75%"></span></>}
</div>
