---
import { lessonDecisions } from '../content/lesson-decisions';
interface Props { lessonId: string; title: string; steps: { label: string; detail: string }[]; }
const { lessonId, title, steps } = Astro.props;
const decisions = lessonDecisions[lessonId] ?? [];
---
<figure class="lesson-flowchart" aria-label={'Sơ đồ luồng ' + title}>
  <figcaption>Sơ đồ luồng · {title}</figcaption>
  <div class="flow-node flow-start">Bắt đầu</div>
  {steps.map((step, index) => <>
    <div class="flow-connector" aria-hidden="true">↓</div>
    <div class="flow-node flow-process"><small>{String(index + 1).padStart(2, '0')} · {step.label}</small>{step.detail}</div>
    {decisions.filter(decision => decision.after === index).map(decision => <>
      <div class="flow-connector" aria-hidden="true">↓</div>
      <div class="flow-gate"><span>{decision.question}</span></div>
      <div class="lesson-branch"><div><b>Không ↓</b><p>{decision.no}</p><small>{decision.noContinues ? 'Tiếp tục dọn dẹp ↓' : 'Kết thúc nhánh'}</small></div><div><b>Có ↓</b><p>{decision.yes}</p><small>Tiếp tục ↓</small></div></div>
    </>)}
  </>)}
  <div class="flow-connector" aria-hidden="true">↓</div><div class="flow-finish">Kết thúc</div>
</figure>
