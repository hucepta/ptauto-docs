---
interface Props { title: string; steps: string[]; technology?: string; output?: string; }
const { title, steps, output } = Astro.props;
const variant = /mạng ống|thoát nước|pipe|topology|hố ga/i.test(title) ? 'network'
  : /profile|trắc|surface|PVI|cao độ/i.test(title) ? 'profile'
  : /cọc|mốc|station|lý trình/i.test(title) ? 'marker'
  : /layer|curve/i.test(title) ? 'layer'
  : /báo cáo|kiểm kê|QA|csv|đối chiếu|kiểm tra|hồ sơ/i.test(title) ? 'report'
  : /tuyến|tọa độ|đường|hình học|cad|gis|bản vẽ|civil|polyline|đỉnh/i.test(title) ? 'route' : 'data';
const descriptions: Record<string, string> = {
  data: 'Dữ liệu đi qua ba bước xử lý và cho ra kết quả',
  report: 'Bảng kết quả hiện từng dòng sau khi kiểm tra',
  marker: 'Các mốc lý trình xuất hiện dọc tim tuyến',
  layer: 'Các đối tượng đường được tô màu theo layer',
  profile: 'Đường trắc dọc và các điểm PVI hiện dần',
  network: 'Mạng ống và điểm lỗi kết nối được đánh dấu',
  route: 'Tim tuyến và vị trí kết quả hiện dần'
};
---
<figure class="process-visual" data-visual-variant={variant}>
  <figcaption><strong>Sơ đồ luồng · {title}</strong><span>Minh họa nguyên lý, không phải ảnh chụp CAD</span></figcaption>
  <ol>{steps.map((step, index) => <li><span>{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}</ol>
  <svg viewBox="0 0 680 180" role="img" aria-label={descriptions[variant]}>
    <rect width="680" height="180" rx="6" fill="#0b2b45"/>
    {variant==='data'&&<g><rect x="36" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><rect x="261" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><rect x="486" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><path class="visual-progress" d="M194 90H486" stroke="#ffd27a" stroke-width="4"/><g fill="#eff9ff" font-size="16" text-anchor="middle"><text x="115" y="96">Dữ liệu</text><text x="340" y="96">Quy tắc</text><text x="565" y="96">Kết quả</text></g></g>}
    {variant==='report'&&<g><rect x="160" y="22" width="360" height="137" rx="4" fill="#f2f9fa"/><path d="M160 58H520M160 91H520M160 124H520M315 22V159" stroke="#9dc5d1"/><rect class="visual-result" x="319" y="61" width="194" height="27" fill="#9be5d6"/><rect class="visual-result" x="319" y="94" width="194" height="27" fill="#ffdc92"/><g fill="#16415a" font-size="13"><text x="180" y="46">Đối tượng</text><text x="335" y="46">Trạng thái</text><text x="180" y="80">ID 01</text><text x="335" y="80">Đạt</text><text x="180" y="113">ID 02</text><text x="335" y="113">Cần xem lại</text><text x="180" y="146">Tổng</text><text x="335" y="146">2 đối tượng</text></g></g>}
    {variant==='marker'&&<g><path d="M38 129C137 149 213 91 321 102S505 68 641 38" stroke="#3a7695" stroke-width="18" stroke-linecap="round"/><path class="visual-progress" d="M38 129C137 149 213 91 321 102S505 68 641 38" stroke="#78e1d3" stroke-width="3"/><g fill="#ffd27a" stroke="#135173" stroke-width="3"><circle cx="38" cy="129" r="9"/><circle cx="178" cy="115" r="9"/><circle cx="324" cy="102" r="9"/><circle cx="477" cy="77" r="9"/><circle cx="641" cy="38" r="9"/></g><g fill="#eff9ff" font-size="12"><text x="29" y="159">0+000</text><text x="166" y="145">0+020</text><text x="310" y="131">0+040</text><text x="462" y="107">0+060</text></g></g>}
    {variant==='layer'&&<g fill="none" stroke-width="5" stroke-linecap="round"><path d="M55 53C180 96 326 24 625 61" stroke="#558eb0"/><path class="visual-progress" d="M55 53C180 96 326 24 625 61" stroke="#73ded0"/><path d="M55 112C180 155 326 83 625 120" stroke="#ffd27a"/><path d="M55 143C180 175 326 132 625 149" stroke="#588cac"/><g fill="#eff9ff" font-size="12" stroke="none"><text x="55" y="28">Layer tuyến</text><text x="55" y="101">Layer kiểm tra</text></g></g>}
    {variant==='profile'&&<g><path d="M36 146H643M36 20V146" stroke="#729fb5" stroke-width="2"/><path d="M48 121L174 110L295 72L427 91L551 48L630 55" stroke="#5c90ad" stroke-width="8" fill="none" stroke-linejoin="round"/><path class="visual-progress" d="M48 121L174 110L295 72L427 91L551 48L630 55" stroke="#72e0cf" stroke-width="3" fill="none"/><g fill="#ffd27a"><circle cx="174" cy="110" r="7"/><circle cx="295" cy="72" r="7"/><circle cx="427" cy="91" r="7"/><circle cx="551" cy="48" r="7"/></g><g fill="#eff9ff" font-size="12"><text x="45" y="163">Station</text><text x="14" y="35">Z</text><text x="282" y="55">PVI</text></g></g>}
    {variant==='network'&&<g><path d="M45 96H240L335 52H480M500 52L630 105" stroke="#4da4c4" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><path class="visual-progress" d="M45 96H240L335 52H480" stroke="#72e0cf" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><g fill="#ffd27a" stroke="#135173" stroke-width="3"><circle cx="45" cy="96" r="10"/><circle cx="240" cy="96" r="10"/><circle cx="335" cy="52" r="10"/><circle cx="630" cy="105" r="10"/></g><circle class="visual-result" cx="490" cy="52" r="15" fill="none" stroke="#ffb16c" stroke-width="4"/><text x="490" y="27" fill="#ffdc92" font-size="13" text-anchor="middle">Đầu rời</text><text x="48" y="126" fill="#eff9ff" font-size="12">Hố ga</text></g>}
    {variant==='route'&&<g><path d="M36 134C130 149 194 95 287 104S458 53 640 40" stroke="#3a7695" stroke-width="19" stroke-linecap="round"/><path class="visual-progress" d="M36 134C130 149 194 95 287 104S458 53 640 40" stroke="#78e1d3" stroke-width="3" stroke-linecap="round"/><g fill="#ffd27a" stroke="#135173" stroke-width="3"><circle cx="36" cy="134" r="9"/><circle cx="185" cy="111" r="9"/><circle cx="335" cy="93" r="9"/><circle cx="490" cy="56" r="9"/><circle cx="640" cy="40" r="9"/></g><text x="38" y="166" fill="#eff9ff" font-size="12">Tim tuyến / đối tượng</text></g>}
  </svg>
  {output&&<p><strong>Kết quả cần đối chiếu:</strong> {output}</p>}
</figure>
