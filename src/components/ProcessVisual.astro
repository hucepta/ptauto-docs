---
interface Props { title: string; steps: string[]; technology?: string; output?: string; }
const { title, steps, technology = 'autolisp', output } = Astro.props;
const isNetwork = technology === 'civil3d-dotnet' || technology === 'gis-data-automation';
const isSpatial = /tuyến|cọc|tọa độ|đường|hình học|curve|layer|ống|trắc|surface|profile|cad|gis|bản vẽ|civil|polyline|mốc|đỉnh/i.test(title);
---
<figure class="process-visual">
  <figcaption><strong>Sơ đồ luồng · {title}</strong><span>Minh họa nguyên lý, không phải ảnh chụp CAD</span></figcaption>
  <ol>{steps.map((step, index) => <li><span>{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}</ol>
  <svg viewBox="0 0 680 180" role="img" aria-label={isNetwork ? 'Sơ đồ mạng hạ tầng và điểm kiểm tra được tô sáng' : 'Sơ đồ tim tuyến và các điểm hoặc đường kết quả được tô sáng'}>
    <rect width="680" height="180" rx="6" fill="#0b2b45"/>
    {!isSpatial ? <g><rect x="36" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><rect x="261" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><rect x="486" y="55" width="158" height="70" rx="5" fill="#164968" stroke="#72e0cf"/><path class="visual-progress" d="M194 90H486" stroke="#ffd27a" stroke-width="4"/><g fill="#eff9ff" font-size="16" text-anchor="middle"><text x="115" y="96">Dữ liệu</text><text x="340" y="96">Quy tắc</text><text x="565" y="96">Kết quả</text></g></g> : isNetwork ? <g><path d="M45 96H240L335 52H490L630 105" stroke="#4da4c4" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><path class="visual-progress" d="M45 96H240L335 52H490L630 105" stroke="#72e0cf" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><g fill="#ffd27a" stroke="#135173" stroke-width="3"><circle cx="45" cy="96" r="10"/><circle cx="240" cy="96" r="10"/><circle cx="335" cy="52" r="10"/><circle cx="490" cy="52" r="10"/><circle cx="630" cy="105" r="10"/></g></g> : <g><path d="M36 134C130 149 194 95 287 104S458 53 640 40" stroke="#3a7695" stroke-width="19" stroke-linecap="round"/><path class="visual-progress" d="M36 134C130 149 194 95 287 104S458 53 640 40" stroke="#78e1d3" stroke-width="3" stroke-linecap="round"/><g fill="#ffd27a" stroke="#135173" stroke-width="3"><circle cx="36" cy="134" r="9"/><circle cx="185" cy="111" r="9"/><circle cx="335" cy="93" r="9"/><circle cx="490" cy="56" r="9"/><circle cx="640" cy="40" r="9"/></g></g>}
    {isSpatial&&<g class="visual-result"><rect x="515" y="131" width="130" height="31" rx="4" fill="#ffdc92"/><text x="580" y="152" fill="#102e45" font-size="13" text-anchor="middle">Kết quả</text></g>}
  </svg>
  {output&&<p><strong>Kết quả cần đối chiếu:</strong> {output}</p>}
</figure>
