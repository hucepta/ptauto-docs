---
import CodePanel from './CodePanel.astro';
import type { ExampleEntry } from '../domain/content/schema';
interface Props {
    example: ExampleEntry;
    code: string;
    anchorId: string;
}
const { example, code, anchorId } = Astro.props;
---
<CodePanel code={code} language={example.language} filename={example.sourceFile.split(/[\\/]/).at(-1)} anchorId={anchorId}>
<h3>{example.title}</h3>
{example.expectedOutput&&<p><strong>Kết quả mong đợi:</strong> {example.expectedOutput}</p>}
</CodePanel>

