---
import SiteLayout from './SiteLayout.astro';
import CourseNavigation from '../components/CourseNavigation.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ContentGraph } from '../domain/content/graph';
interface Props {
    title: string;
    description: string;
    graph: ContentGraph;
    courseId: string;
    activeId?: string;
    headings?: {
        depth: number;
        slug: string;
        text: string;
    }[];
}
const { title, description, graph, courseId, activeId, headings = [] } = Astro.props;
---
<SiteLayout title={title} description={description}><div class="reader-grid">
<aside class="reader-sidebar"><div class="sidebar-inner"><CourseNavigation graph={graph} courseId={courseId} activeId={activeId} /></div></aside>
<article class="reader-article"><slot /></article><TableOfContents headings={headings} />
</div></SiteLayout>

