---
import '../styles/tokens.css';
import '../styles/reading.css';
import '../styles/interface.css';
import '../styles/motion.css';
import { withBase } from '../domain/content/urls';
import { getBuildData } from '../content/build-data';
const { buildId } = await getBuildData();
interface Props {
    title: string;
    description: string;
    activeSection?: 'dictionary';
}
const { title, description, activeSection } = Astro.props;
const nav = [['Kho tri thức', '/#chu-de'], ['Tra cứu', '/tra-cuu/'], ['Từ điển', '/thuat-ngu/'], ['Dự án mẫu', '/du-an/'], ['Đánh dấu', '/da-luu/']];
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<!doctype html>
<html lang="vi">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" /><meta name="description" content={description} />
<script is:inline>document.documentElement.classList.add('js');</script>
<title>{title==='PTAuto Docs'?title:title+' · PTAuto Docs'}</title>
<meta name="ptauto-build" content={buildId} />
<link rel="icon" type="image/svg+xml" href={withBase('/brand-logo.svg#symbol')} /><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)} />
</head>
<body>
<svg class="site-drawing" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><g fill="none" stroke="#71cde7" stroke-width="1.5"><path d="M-80 675 C230 520 385 750 670 558 S1120 268 1510 420"/><path d="M-60 718 C230 563 400 793 690 601 S1130 311 1510 463"/><path d="M-50 761 C250 606 415 836 710 644 S1150 354 1510 506"/><path d="M-30 804 C270 649 430 879 730 687 S1170 397 1510 549"/></g><g fill="#8ce9da" stroke="#0e5776" stroke-width="3"><circle cx="670" cy="558" r="6"/><circle cx="970" cy="374" r="6"/><circle cx="1230" cy="329" r="6"/></g></svg>
<a class="skip-link" href="#content">Đến nội dung</a>
<header class="site-header" data-pagefind-ignore><div class="header-inner">
<a class="brand" href={withBase('/')} aria-label="PTAuto Docs — Trang chủ"><img src={withBase('/brand-logo.svg')} width="174" height="53" alt="PTAuto Docs" /></a>
<nav id="primary-nav" class="primary-nav" aria-label="Điều hướng chính" data-primary-nav>
{nav.map(([label,href])=><a href={withBase(href)} data-knowledge-nav={href==='/#chu-de'?'':undefined} aria-current={(activeSection==='dictionary'?href==='/thuat-ngu/':href==='/#chu-de'?pathname.startsWith('/hoc/'):pathname.startsWith(href))?'page':undefined}>{label}</a>)}
</nav></div></header>
<main id="content" tabindex="-1"><slot /></main>
<script>import '../client/navigation';</script>
<script>import '../client/learning';</script>
<script>import '../client/disclosures';</script>
</body></html>

